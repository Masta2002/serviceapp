msgid "Set buffer duration in seconds."
msgstr "Imposta la durata del buffer in secondi"

msgid "Set buffer size in kilobytes."
msgstr "Imposta la dimensione del buffer in kilobyte"

msgid "Set connection speed in kb/s, according to which you want to have streams auto-selected"
msgstr "Imposta la velocità di connessione in Kb/s in modo che i flussi vengano selezionati automaticamente"

msgid "Set which RTMP protocol implementation will be used for playback of RTMP streams"
msgstr "Impostare quale implementazione del protocollo RTMP verrà utilizzata per la riproduzione di flussi RTMP"

msgid "Sink"
msgstr "Recipiente"

msgid "Software decoder use LPCM for injection (otherwise wav PCM will be used)"
msgstr "Il software del decoder userà LPCM (altrimenti sarà usata PCM)"

msgid "Stereo downmix"
msgstr "Miscelazione stereo"

msgid "Stop playing this movie?"
msgstr "Arrestare la riproduzione?"

