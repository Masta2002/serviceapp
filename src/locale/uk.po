msgstr "HLS: лише звукова доріжка за замовчуванням"

msgid "HLS quality"
msgstr "Якість HLS"

msgid "Highest"
msgstr "Найвища"

msgid "LPCM injection"
msgstr "Вставка LPCM"

msgid "Lowest"
msgstr "Найнижча"

