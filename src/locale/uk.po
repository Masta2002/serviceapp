msgstr "Програмне декодування MP3"

msgid "No"
msgstr "Ні"

msgid "Offer only the default audio track of a HLS stream instead of all of its languages."
msgstr "Пропонувати лише звукову доріжку HLS-потоку за замовчуванням замість усіх його мов."

msgid "Play with ServiceExtEplayer3"
msgstr "Програвати в ServiceExtEplayer3"

msgid "Play with ServiceGstPlayer"
msgstr "Програвати в ServiceGstPlayer"

msgid "Player"
msgstr "Програвач"

msgid "RTMP protocol implementation"
msgstr "Реалізація протоколу RTMP"

msgid "Resolving the stream address failed"
msgstr "Не вдалося визначити адресу потоку"

msgid "Select sink which you want to use."
msgstr "Виберіть пристрій виводу."

msgid "Select the delay that will be used for AC3+ Passthrough fix."
msgstr "Виберіть затримку для виправлення passthrough AC3+."

msgid "Select the player which will be used for Enigma2 playback."
msgstr "Виберіть плеєр, який буде використовуватися системою для програвання."

msgid "Select the player which will be used in serviceapp for Enigma2 playback."
msgstr "Виберіть плеєр, який буде використовується ServiceApp для програвання системою."

msgid "ServiceApp"
msgstr "ServiceApp"

msgid "ServiceApp - player check"
msgstr "ServiceApp - перевірка програвачів"

