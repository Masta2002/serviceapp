msgid "ServiceExtEplayer3 (%s)"
msgstr "ServiceExtEplayer3 (%s)"

#, python-format
msgid "ServiceGstPlayer (%s)"
msgstr "ServiceGstPlayer (%s)"

#, python-format
msgid "ServiceMp3 (%s)"
msgstr "ServiceMp3 (%s)"

msgid "Set buffer duration in seconds."
msgstr "Встановлює тривалість буферизації в секундах."

msgid "Set buffer size in kilobytes."
msgstr "Встановлює розмір буферізації в кілобайтах."

msgid "Set connection speed in kb/s, according to which you want to have streams auto-selected"
msgstr "Встановлює швидкість з'єднання в кб/с, відповідно до якої Ви бажаєте, щоб потоки автоматично вибиралися"

msgid "Set which RTMP protocol implementation will be used for playback of RTMP streams"
msgstr "Встановіть, яка реалізація протоколу RTMP буде використовуватися для відтворення потоків RTMP"

msgid "Sink"
msgstr "Приймач"

msgid "Software decoder use LPCM for injection (otherwise wav PCM will be used)"
msgstr "Використовувує LPCM для програмного декодування (в інших випадках wav PCM)"

msgid "Stereo downmix"
msgstr "Мікшувати в стерео"

msgid "Stop playing this movie?"
msgstr "Припинити програвання фільму?"

msgid "To AAC ADTS"
msgstr "До AAC ADTS"

msgid "To AAC LATM"
msgstr "До AAC LATM"

msgid "Turn on AAC software decoding."
msgstr "Вмикає програмне декодування AAC."

msgid "Turn on AC3 software decoding."
msgstr "Вмикає програмне декодування AC3."

msgid "Turn on DTS software decoding."
msgstr "Вмикає програмне декодування DTS."

msgid "Turn on EAC3 software decoding."
msgstr "Вмикає програмне декодування EAC3."

msgid "Turn on MP3 software decoding."
msgstr "Вмикає програмне декодування MP3."

msgid "Turn on WMA1, WMA2, WMA/PRO software decoding."
msgstr "Вмикає програмне декодування WMA1, WMA2, WMA/PRO."

msgid "Turn on auto-selection of streams according to set Connection speed."
msgstr "Вмикає автоматичний вибір потоків відповідно до встановленої швидкості з'єднання."

msgid "Turn on debug messages"
msgstr "Увімкнути налагоджувальні повідомлення"

msgid "Turn on downmix to stereo, when software decoding is in use"
msgstr "Вмикає знижуюче мікшування в стерео, коли використовується програмне декодування"

msgid "Turn on explorer to retrieve different quality streams from HLS variant playlist and select them via subservices."
msgstr "Вмикає провідник для витягання потоків різної якості з плейлиста варіантів HLS та вибирати їх через субсервіси."

msgid "Turn on the embedded subtitles support."
msgstr "Вмикає підтримку вбудованих субтитрів."

msgid "Variant of a HLS or DASH stream the player picks: Auto and Highest play the best one, Lowest the smallest."
msgstr "Варіант потоку HLS або DASH, який вибирає програвач: Авто і Найвища — найкращий, Найнижча — найменший."

msgid "WMA software decoding"
msgstr "Програмне декодування WMA"

msgid "Yes"
msgstr "Так"

