msgid "Set buffer duration in seconds."
msgstr "Állítsa be a puffer időtartamát másodpercben."

msgid "Set buffer size in kilobytes."
msgstr "Állítsa be a puffer méretét kilobájtban."

msgid "Set connection speed in kb/s, according to which you want to have streams auto-selected"
msgstr "Állítsa be azt a kapcsolódási sebességet kb/s-ban, amely szerint az adatfolyamokat a rendszer automatikusan kiválasztja"

msgid "Set which RTMP protocol implementation will be used for playback of RTMP streams"
msgstr "Állítsa be, hogy melyik RTMP protokoll implementációt használja a rendszer az RTMP-adatfolyamok lejátszására"

msgid "Sink"
msgstr "Fogadó"

msgid "Software decoder use LPCM for injection (otherwise wav PCM will be used)"
msgstr "LPCM injection használata szoftveres dekóderhez (egyébként PCM injection használat)"

msgid "Stereo downmix"
msgstr "Sztereó lekeverés"

msgid "Stop playing this movie?"
msgstr "Megállítsam ezt a lejátszást?"

msgid "To AAC ADTS"
msgstr "AAC az ADTS-hez"

msgid "To AAC LATM"
msgstr "AAC a LATM-hez"

msgid "Turn on AAC software decoding."
msgstr "Itt kapcsolhatja be az AAC szoftverdekódolást."

msgid "Turn on AC3 software decoding."
msgstr "Itt kapcsolhatja be az AC3 szoftverdekódolást."

msgid "Turn on DTS software decoding."
msgstr "Itt kapcsolhatja be a DTS szoftverdekódolást."

msgid "Turn on EAC3 software decoding."
msgstr "Itt kapcsolhatja be az EAC3 szoftverdekódolást."

msgid "Turn on MP3 software decoding."
msgstr "Itt kapcsolhatja be az MP3 szoftverdekódolást."

msgid "Turn on WMA1, WMA2, WMA/PRO software decoding."
msgstr "Itt kapcsolhatja be a WMA1, WMA2, WMA/PRO szoftverdekódolást."

msgid "Turn on auto-selection of streams according to set Connection speed."
msgstr "A kapcsolat sebességének beállítása szerint automatikusan történik az adatfolyam (stream) kiválasztása."

msgid "Turn on debug messages"
msgstr "Hibakeresési üzenetek bekapcsolása"

msgid "Turn on downmix to stereo, when software decoding is in use"
msgstr "Sztereó lekeverés bekapcsolása, ha valamilyen szoftverdekódolás van használatban"

msgid "Turn on explorer to retrieve different quality streams from HLS variant playlist and select them via subservices."
msgstr "Ha különböző minőségű adatfolyamokat (stream) szeretne megjeleníteni, akkor kapcsolja be a HLS Explorert."

msgid "Turn on the embedded subtitles support."
msgstr "Itt kapcsolhatja be a beágyazott feliratok támogatását."

msgid "Variant of a HLS or DASH stream the player picks: Auto and Highest play the best one, Lowest the smallest."
msgstr "A lejátszó által választott HLS vagy DASH változat: Automatikus és Legmagasabb a legjobbat, Legalacsonyabb a legkisebbet játssza."

