msgstr "uz AAC ADTS"

msgid "To AAC LATM"
msgstr "uz AAC LATM"

msgid "Turn on AAC software decoding."
msgstr "Izslēgt AAC dekodēšanu."

msgid "Turn on AC3 software decoding."
msgstr "Lietot AC3 dekodēšanu."

msgid "Turn on DTS software decoding."
msgstr "Izslēgt DTS dekodēšanu."

