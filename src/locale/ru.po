msgstr "ServiceMp3 (%s)"

msgid "Set buffer duration in seconds."
msgstr "Установите длительность буферизации в секундах."

msgid "Set buffer size in kilobytes."
msgstr "Установите размер буферизации в килобайтах."

msgid "Set connection speed in kb/s, according to which you want to have streams auto-selected"
msgstr "Установите скорость соединения в кб/с, в соответствии с которой Вы хотите, чтобы потоки автоматически выбирались"

msgid "Set which RTMP protocol implementation will be used for playback of RTMP streams"
msgstr "Какая реализация протокола RTMP используется для потоков RTMP"

msgid "Sink"
msgstr "Приёмник"

msgid "Software decoder use LPCM for injection (otherwise wav PCM will be used)"
msgstr "Использовать LPCM в программном декодере (в иных случаях wav PCM)"

msgid "Stereo downmix"
msgstr "Микшировать в стерео"

msgid "Stop playing this movie?"
msgstr "Прекратить воспроизведение фильма?"

msgid "To AAC ADTS"
msgstr "В AAC ADTS"

msgid "To AAC LATM"
msgstr "В AAC LATM"

msgid "Turn on AAC software decoding."
msgstr "Включает программное декодирование AAC."

msgid "Turn on AC3 software decoding."
msgstr "Включить программное декодирование AC3."

msgid "Turn on DTS software decoding."
msgstr "Включает программное декодирование DTS."

msgid "Turn on EAC3 software decoding."
msgstr "Включить программное декодирование EAC3."

msgid "Turn on MP3 software decoding."
msgstr "Включить программное декодирование MP3."

msgid "Turn on WMA1, WMA2, WMA/PRO software decoding."
msgstr "Включает программное декодирование WMA1, WMA2, WMA/PRO."

msgid "Turn on auto-selection of streams according to set Connection speed."
msgstr "Включает автоматический выбор потоков в соответствии с установленной скоростью соединения."

msgid "Turn on debug messages"
msgstr "Включить отладочные сообщения"

msgid "Turn on downmix to stereo, when software decoding is in use"
msgstr "Включает понижающее микширование в стерео, когда используется программное декодирование"

msgid "Turn on explorer to retrieve different quality streams from HLS variant playlist and select them via subservices."
msgstr "Включает проводник, для извлечения потоков различного качества из плейлиста вариантов HLS и их выбора через субсервисы."

msgid "Turn on the embedded subtitles support."
msgstr "Включает поддержку встроенных субтитров."

msgid "Variant of a HLS or DASH stream the player picks: Auto and Highest play the best one, Lowest the smallest."
msgstr "Вариант потока HLS или DASH, который выбирает плеер: Авто и Наивысшее — лучший, Наименьшее — самый маленький."

